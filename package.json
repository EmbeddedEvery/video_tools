{
  "name": "video-tools",
  "version": "0.1.0",
  "private": true,
  "description": "本地视频 / 图片工具套件：查重、浏览、整理，可扩展",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electronmon .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "fix:electron": "node scripts/ensure-electron.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "electronmon": "^2.0.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "wait-on": "^8.0.3"
  },
  "electronmon": {
    "patterns": [
      "electron/**/*"
    ]
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true
  }
}
